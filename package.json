{
  "name": "vitalmesh",
  "description": "Unified homelab and multi-node cluster orchestrator",
  "author": "Crazykiddo.net",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "xbuild": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:cpu-features --sourcemap --outfile=dist/server.cjs",
    "build": "vite build --mode production && esbuild server.ts --bundle --platform=node --format=cjs --external:cpu-features --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "build:backend": "esbuild backend/server.cjs --bundle --platform=node --target=node20 --outfile=dist/backend/server.cjs",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "io.vitalmesh.desktop",
    "productName": "VitalMesh",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "dist",
        "to": "backend/dist"
      },
      {
        "from": "dist/server.cjs",
        "to": "backend/server.cjs"
      },
      {
        "from": "node_modules/@libsql",
        "to": "backend/node_modules/@libsql"
      },
      {
        "from": "node_modules/cpu-features",
        "to": "backend/node_modules/cpu-features"
      }
    ]
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ssh2": "^1.17.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
